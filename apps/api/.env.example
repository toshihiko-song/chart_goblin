# Matches the defaults in the root docker-compose.yml
DATABASE_URL="postgresql://goblin:goblin@localhost:5433/chart_goblin?schema=public"
PORT=3001

# External APIs (defaults shown). api.mexc.co is used because api.mexc.com is blocked on some networks.
# COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
# COINGECKO_API_KEY=
# MEXC_BASE_URL=https://api.mexc.co

# Set to false to disable cron jobs (manual endpoints still work)
# SCHEDULER_ENABLED=true

# Telegram alerts: create a bot via @BotFather, then get your chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
